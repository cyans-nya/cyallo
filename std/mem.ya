use std::result::Result;

pub mod manual;

pub record Layout {}
pub record Allocation {}
pub record AllocError {}

pub trait Cloneable {}

// A value that is duplicated by reading it, rather than moved.
pub trait Copy {}

pub trait Allocator {
    proc allocate(self: &mut Self, layout: Layout) -> Result<Allocation, AllocError>;
    proc deallocate(self: &mut Self, allocation: Allocation);
}

impl Layout {
    pub fn new(size: usize, alignment: usize) -> Result<Layout, AllocError>;
    pub fn size(self: &Self) -> usize;
    pub fn align(self: &Self) -> usize;
}

impl AllocError {
    pub fn new(read message: string) -> AllocError;
}

pub proc allocate(layout: Layout) -> Result<Allocation, AllocError>;
pub proc deallocate(allocation: Allocation);
pub proc drop<T>(value: T);
pub proc clone<T: Cloneable>(value: &T) -> T;
