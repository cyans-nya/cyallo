use std::array::Range;
use std::option::Option;

pub trait Collection<T> {}
pub trait NumericCollection<T> {}

pub record Vec<T> {}
pub record VecDeque<T> {}

impl<T> Vec<T> {
    pub fn from(read values: Range<T>) -> Vec<T>;
    pub proc push(self: &mut Self, value: T);
    pub proc push_back(self: &mut Self, value: T);
    pub proc pop(self: &mut Self) -> Option<T>;
    pub proc pop_back(self: &mut Self) -> Option<T>;
    pub fn len(self: &Self) -> usize;
    pub fn as_slice(self: &Self) -> &[]T;
    pub fn as_mut_slice(self: &mut Self) -> &mut []T;
}

impl<T> VecDeque<T> {
    pub fn from(read values: Range<T>) -> VecDeque<T>;
    pub proc push(self: &mut Self, value: T);
    pub proc push_back(self: &mut Self, value: T);
    pub proc push_front(self: &mut Self, value: T);
    pub proc pop(self: &mut Self) -> Option<T>;
    pub proc pop_back(self: &mut Self) -> Option<T>;
    pub proc pop_front(self: &mut Self) -> Option<T>;
    pub fn len(self: &Self) -> usize;
}
