use std::num::{Numeric, Integer};
use std::collections::{Collection, NumericCollection};

pub record Range<T> {}

// These type families retain their declaration identity until call checking.
pub record RangeArray<RangeValue> {}
pub record EmptyArray<T> {}

pub fn empty<T>() -> EmptyArray<T>;
pub fn from<T: Integer>(read range: Range<T>) -> RangeArray<range>;
pub fn len<T, C: Collection<T>>(read values: C) -> i64;
pub fn sum<T: Numeric, C: NumericCollection<T>>(read values: C) -> T;

impl<T> Range<T> {
    pub fn rev(read self) -> Self;
}

impl<T> []T {
    pub fn len(self: &Self) -> usize;
    pub fn as_slice(self: &Self) -> &[]T;
    pub fn as_mut_slice(self: &mut Self) -> &mut []T;
}
