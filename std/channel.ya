use std::task::Transferable;
use std::result::Result;

pub record Sender<T> {}
pub record Receiver<T> {}
pub enum SendError<T> {
    Closed: T,
    Full: T,
    Limit: T,
}
pub enum ReceiveError {
    Closed,
    Empty,
}

pub proc bounded<T: Transferable>(capacity: usize) -> (Sender<T>, Receiver<T>);
pub proc unbounded<T: Transferable>() -> (Sender<T>, Receiver<T>);

impl<T> Sender<T> {
    pub proc clone(self: &Self) -> Self;
    pub proc close(self: &Self);
    pub proc is_closed(self: &Self) -> bool;
    pub proc send(self: &Self, value: T) -> Result<(), SendError<T>>;
    pub proc try_send(self: &Self, value: T) -> Result<(), SendError<T>>;
}

impl<T> Receiver<T> {
    pub proc clone(self: &Self) -> Self;
    pub proc close(self: &Self);
    pub proc is_closed(self: &Self) -> bool;
    pub proc recv(self: &Self) -> Result<T, ReceiveError>;
    pub proc try_recv(self: &Self) -> Result<T, ReceiveError>;
}

impl<T> SendError<T> {
    pub proc into_value(self) -> T;
    pub proc is_closed(self: &Self) -> bool;
    pub proc is_full(self: &Self) -> bool;
    pub proc is_limit(self: &Self) -> bool;
}

impl ReceiveError {
    pub proc is_closed(self: &Self) -> bool;
    pub proc is_empty(self: &Self) -> bool;
}
