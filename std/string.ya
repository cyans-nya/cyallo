use std::io::Printable;

pub fn len(read value: string) -> i64;
pub fn trim(read value: string) -> string;
pub fn upper(read value: string) -> string;
pub fn lower(read value: string) -> string;
pub fn contains(read value: string, read pattern: string) -> bool;
pub fn starts_with(read value: string, read pattern: string) -> bool;
pub fn ends_with(read value: string, read pattern: string) -> bool;
pub fn replace(read value: string, read pattern: string, read replacement: string) -> string;
pub fn from<T: Printable>(read value: T) -> string;
