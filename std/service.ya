pub record Context {}
pub record Registration {}
pub record ServiceKey<T> {}
pub record ServiceRef<T> {}

impl Context {
    pub proc new() -> Context;
    pub proc extend(self: &Self) -> Context;
    pub proc isolate<T>(self: &Self, read key: ServiceKey<T>) -> Context;
    pub proc service<T>(self: &Self, read key: ServiceKey<T>) -> ServiceRef<T>;
    pub proc provide<T>(self: &Self, read key: ServiceKey<T>, value: T) -> Registration;
    pub proc available<T>(self: &Self, read key: ServiceKey<T>) -> bool;
    pub proc dispose(self: &Self);
    pub proc inject<T>(self: &Self, read key: ServiceKey<T>, callback: proc(Context));
    pub proc on_dispose(self: &Self, callback: proc());
}

impl<T> ServiceKey<T> {
    pub proc new(read label: string) -> ServiceKey<T>;
}

impl Registration {
    pub proc dispose(self: &Self);
}
