use std::mem::{Allocator, AllocError};
use std::option::Option;
use std::result::Result;
use std::lookup::Target;

pub trait RcOwner {}
pub trait WeakOwner {}

pub record Weak<T> {}

pub record AllocatedRc<T, AllocatorValue> {}
pub record WeakOf<Owner> {}

pub proc try_new_in<T, A: Allocator>(value: T, allocator: A) -> Result<AllocatedRc<T, allocator>, AllocError>;
pub proc clone<O: RcOwner>(owner: &O) -> O;
pub proc downgrade<O: RcOwner>(owner: &O) -> WeakOf<O>;
pub proc upgrade<W: WeakOwner>(owner: &W) -> Option<Target<W>>;
pub proc strong_count<O: RcOwner>(owner: &O) -> usize;
pub proc weak_count<O: RcOwner>(owner: &O) -> usize;

impl<T> rc T {
    pub proc clone(self: &Self) -> Self;
    pub proc downgrade(self: &Self) -> WeakOf<Self>;
    pub proc strong_count(self: &Self) -> usize;
    pub proc weak_count(self: &Self) -> usize;
}

impl<T> Weak<T> {
    pub proc upgrade(self: &Self) -> Option<Target<Self>>;
}
