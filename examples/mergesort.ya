// Stable merge sort with a reusable scratch array and ref parameters.
// Run: cargo run -- run examples/mergesort.ya
proc merge_sort(a: &mut []i64, scratch: &mut []i64, lo: i64, hi: i64) {
    if lo >= hi { return }
    let mid = (lo + hi) div 2
    merge_sort(a, scratch, lo, mid)
    merge_sort(a, scratch, mid + 1, hi)
    let mut left = lo
    let mut right = mid + 1
    let mut out = lo
    while left <= mid && right <= hi {
        if a[left] <= a[right] {
            scratch[out] = a[left]
            left += 1
        } else {
            scratch[out] = a[right]
            right += 1
        }
        out += 1
    }
    while left <= mid {
        scratch[out] = a[left]
        left += 1
        out += 1
    }
    while right <= hi {
        scratch[out] = a[right]
        right += 1
        out += 1
    }
    for p in lo..=hi {
        a[p] = scratch[p]
    }
}

let n = 800
let mut a = std::collections::Vec::from(0..n)
let mut scratch = std::collections::Vec::from(0..n)
let mut seed = 98765
for i in 0..=n - 1 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    a[i] = seed % 1000003
}
merge_sort(&mut a, &mut scratch, 0, n - 1)
std::io::print(std::array::sum(a), ":", a[0], ":", a[n - 1])
