// cargo run -- run examples/concurrency/modules/main.yas --gc-stress
// Expected: 42
type Plugin = object { answer: proc() -> i64 }

proc work() -> i64 {
    let plugin = std::module::load("plugin.ya").unwrap()
    return plugin.answer()
}

let first = std::task::spawn(work)
let second = std::task::spawn(work)
std::io::print(first.join().completed() + second.join().completed())
