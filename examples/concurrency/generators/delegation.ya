// Run: cargo run -- run examples/concurrency/generators/delegation.ya
// gen fn is pure and captures nothing. yield from owns and drives its delegate.
use std::generator::Generator
use std::io::print

let child = gen fn(start: i64) -> Generator<i64, i64, i64> {
    let reply = yield start
    return reply + 1
}
let parent = gen proc(start: i64) -> Generator<i64, i64, i64> {
    let delegated = yield from child(start)
    return delegated * 2
}

let mut values = parent(7)
let first = values.resume()
print("yielded: ", first.yielded())
let last = values.resume(20)
print("complete: ", last.completed())
