// Run: cargo run -- run examples/concurrency/generators/sequence.ya --engine interpreter
// A factory captures offset; calling it constructs a lazy stackless generator.
use std::generator::Generator
use std::io::print

let offset = 10
let sequence = gen proc(count: i64) -> Generator<i64, (), i64> {
    let mut index = 0
    while index < count {
        yield offset + index
        index += 1
    }
    return count
}

let mut values = sequence(3)
let first = values.resume()
print(first.yielded())
let second = values.resume()
print(second.yielded())
let third = values.resume()
print(third.yielded())
let finished = values.resume()
print("complete: ", finished.completed())
values.close()
values.close()
