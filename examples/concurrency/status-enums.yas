// cargo run -- run examples/concurrency/status-enums.yas --gc-stress
// Output: "7", "complete: finished", "recovered: second", "empty", "closed".
use std::generator::{Generator, Step}
use std::channel::{SendError, ReceiveError}

let sequence = gen proc() -> Generator<i64, (), string> {
    yield 7
    return "finished"
}
let mut values = sequence()
match values.start() {
    Step::Yielded(number) => std::io::print(number),
    Step::Complete(_) => {},
}
match values.resume() {
    Step::Complete(text) => std::io::print("complete: ", text),
    Step::Yielded(_) => {},
}
let endpoints = std::channel::bounded<string>(1 as usize)
endpoints.0.send("first").unwrap()
match endpoints.0.try_send("second").unwrap_err() {
    SendError::Full(value) | SendError::Closed(value) | SendError::Limit(value) => {
        std::io::print("recovered: ", value)
    },
}
std::mem::drop(endpoints.1.recv().unwrap())
match endpoints.1.try_recv().unwrap_err() {
    ReceiveError::Empty => std::io::print("empty"),
    ReceiveError::Closed => {},
}
endpoints.0.close()
match endpoints.1.recv().unwrap_err() {
    ReceiveError::Closed => std::io::print("closed"),
    ReceiveError::Empty => {},
}
