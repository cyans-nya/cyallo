pub fn r0(x: i64) -> i64 {
    let mut a = x + 0
    let mut b = 1
    a = (a * 3 + 0) % 1000003
    if a > 1000001 {
        a = a - 2
    }
    b = (b + a % 4) % 1009
    a = (a + b * 4) % 1000003
    a = (a * 3 + 4) % 1000003
    if a > 1000005 {
        a = a - 6
    }
    b = (b + a % 8) % 1009
    a = (a + b * 3) % 1000003
    return a + b
}

