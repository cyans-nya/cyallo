pub fn r1(x: i64) -> i64 {
    let mut a = x + 1
    let mut b = 1
    a = (a * 3 + 1) % 1000003
    if a > 1000002 {
        a = a - 3
    }
    b = (b + a % 5) % 1009
    a = (a + b * 5) % 1000003
    a = (a * 3 + 5) % 1000003
    if a > 1000006 {
        a = a - 7
    }
    b = (b + a % 2) % 1009
    a = (a + b * 4) % 1000003
    return a + b
}

