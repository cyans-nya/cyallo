// Run: cargo run -- run examples/gc-cycles.ya --gc-stress --jit-report
// Both edges are strong GC references. No weak edge is needed to reclaim the cycle.
use std::cell::Cell
use std::collections::Vec

record Node { value: i64, edges: Cell<@gc Vec<@gc Node>> }

proc make_cycle(value: i64) -> @gc Node {
    let first = @gc Node { value: value, edges: Cell::new(@gc Vec<@gc Node>[]) }
    let second = @gc Node { value: value + 10, edges: Cell::new(@gc Vec<@gc Node>[]) }
    *first.edges = @gc Vec[second]
    *second.edges = @gc Vec[first]
    return first
}

proc show_cycle() {
    let first = make_cycle(10)
    let second = (*first.edges)[0]
    let back = (*second.edges)[0]
    std::io::print("cycle: ", first.value, " -> ", second.value, " -> ", back.value)
}

proc temporary_cycle(value: i64) {
    let root = make_cycle(value)
    // When this invocation returns, only the two nodes refer to each other.
}

show_cycle()
for i = 0 to 127 { temporary_cycle(i) }
std::io::print("temporary cycles: 128")
