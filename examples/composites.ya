// Records, tuples, first-class functions, and two kinds of closure capture.
// Run: cargo run -- run examples/composites.ya
record Point {
    x: f64
    y: f64
}

fn apply(f: fn(i64) -> i64, n: i64) -> i64 {
    return f(n)
}

// Default captures own a value copy, so this closure can be returned.
fn offset_by(offset: i64) -> fn(i64) -> i64 {
    return fn(n: i64) -> i64 { return n + offset }
}

let offset = offset_by(3)
let point = Point { x: 1, y: 2 }
let pair = (point, offset)
std::io::print(pair.0.x, ":", apply(pair.1, 4))

proc twice(action: &mut proc()) {
    action()
    action()
}

proc count_twice() -> i64 {
    let mut count = 0
    // This closure borrows count. It can be passed to twice while count is
    // alive; returning the borrowed closure would be a compile error.
    let mut increment = proc[&mut count]() { count += 1 }
    twice(&mut increment)
    return count
}

std::io::print(count_twice())
