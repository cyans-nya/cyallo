// In-place partitioning and recursive ref parameters; generated input is reproducible.
// Run: cargo run -- run examples/quicksort.yas
proc quicksort(a: &mut []i64, lo: i64, hi: i64) {
    if lo >= hi { return }
    let pivot = a[hi]
    let mut i = lo
    for j in lo..=hi - 1 {
        if a[j] < pivot {
            let swap = a[i]
            a[i] = a[j]
            a[j] = swap
            i += 1
        }
    }
    let swap2 = a[i]
    a[i] = a[hi]
    a[hi] = swap2
    quicksort(a, lo, i - 1)
    quicksort(a, i + 1, hi)
}

let n = 1000
let mut a = std::collections::Vec::from(0..n)
let mut seed = 12345
for i in 0..=n - 1 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    a[i] = seed % 1000003
}
quicksort(&mut a, 0, n - 1)
std::io::print(std::array::sum(a), ":", a[0], ":", a[n - 1])
