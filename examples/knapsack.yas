// Compare 0/1 knapsack with unbounded knapsack on the same generated items.
// Run: cargo run -- run examples/knapsack.yas
// These algorithms use explicitly zero-filled growable buffers.
fn zeros(count: i64) -> std::collections::Vec<i64> {
    let mut result = std::collections::Vec<i64>[]
    for position in 0..=count - 1 {
        result.push(0)
    }
    return result
}

let items = 40
let capacity = 200
let mut weights = std::collections::Vec::from(0..items)
let mut values = std::collections::Vec::from(0..items)
let mut seed = 7
for i in 0..=items - 1 {
    seed = (seed * 1103515245 + 12345) % 2147483648
    weights[i] = seed % 37 + 1
    seed = (seed * 1103515245 + 12345) % 2147483648
    values[i] = seed % 97 + 1
}

// Descending capacities allow each item to be chosen at most once.
let mut zero_one = zeros(capacity + 1)
for i in 0..=items - 1 {
    for c in (weights[i]..=capacity).rev() {
        let candidate = zero_one[c - weights[i]] + values[i]
        if candidate > zero_one[c] {
            zero_one[c] = candidate
        }
    }
}
std::io::print(zero_one[capacity])

// Ascending capacities allow an item to be used repeatedly.
let mut unbounded = zeros(capacity + 1)
for c in 1..=capacity {
    for i in 0..=items - 1 {
        if weights[i] <= c {
            let candidate2 = unbounded[c - weights[i]] + values[i]
            if candidate2 > unbounded[c] {
                unbounded[c] = candidate2
            }
        }
    }
}
std::io::print(unbounded[capacity])
