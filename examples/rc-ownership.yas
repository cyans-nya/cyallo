// Run: cargo run -- run examples/rc-ownership.yas
// RC owners move; cloning explicitly creates another counted owner.

fn read(value: &rc i64) -> i64 {
    // A pure function can read through a borrowed owner without changing counts.
    return value.*.*
}

let original = rc 42
let weak = std::rc::downgrade(&original)
let cloned = std::rc::clone(&original)
std::io::print("strong: ", std::rc::strong_count(&original))

let survivor = cloned // Move this owner; the count remains two.
std::mem::drop(original)
std::io::print("survivor: ", read(&survivor))

// A successful upgrade creates a counted owner that must also be released.
let upgraded = std::rc::upgrade(&weak).unwrap()
std::io::print("upgraded: ", read(&upgraded), ":", std::rc::strong_count(&survivor))
std::mem::drop(upgraded)
std::mem::drop(survivor)

// The weak handle keeps its control block, but does not keep the payload alive.
std::io::print("expired: ", std::rc::upgrade(&weak).is_none())
std::mem::drop(weak)
