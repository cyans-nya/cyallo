// Scan decimal integers out of repeated, delimiter-separated text.
// Run: cargo run -- run examples/parser.yas
const sample = (
    "ab12,cd345;ef6?gh7890|ij1 kl22 mn333 op4444 qr5 st66 uv777 wx8888 yz9 " +
    "AB12,CD345;EF6?GH7890|IJ1 KL22 MN333 OP4444 QR5 ST66 UV777 WX8888 YZ9 " +
    "12ab,345cd;6ef?7890gh|1ij 22kl 333mn 4444op 5qr 66st 777uv 8888wx 9yz " +
    "xy98,wv765;ut4?sr3210|qp9 on88 nm777 lk6666 ji5 hg44 fe333 dc2222 ba1 "
)
const text = sample + sample + sample + sample

proc parse(s: &string, out: &mut std::collections::Vec<i64>) -> i64 {
    let mut count = 0
    let mut value = 0
    let mut in_number = false
    // String positions are one-based; output array indices start at zero.
    for i in 1..=std::string::len(s.*) {
        let ch = std::runtime::caie::mid(s.*, i, 1)
        if ch >= "0" && ch <= "9" {
            value = value * 10 + std::num::parse<i64>(ch).unwrap()
            in_number = true
        } else if in_number {
            if count < out.len() as i64 { out[count] = value } else { out.push(value) }
            count += 1
            value = 0
            in_number = false
        }
    }
    // Also flush a final number when the input has no trailing delimiter.
    if in_number {
        if count < out.len() as i64 { out[count] = value } else { out.push(value) }
        count += 1
    }
    return count
}

let reps = 200
// Begin empty so the checksum includes only parsed tokens.
let mut tokens = std::collections::Vec<i64>[]
let mut total = 0
for k in 1..=reps {
    total += parse(&text, &mut tokens)
}
std::io::print(total, ":", tokens[0], ":", std::array::sum(tokens))
