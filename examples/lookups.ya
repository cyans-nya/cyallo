// Relative paths are cached; values are acquired from current storage on each hit.
// Run: cargo run -- run examples/lookups.ya --gc-stress
use std::lookup::StoragePath
record Directory {
    names: Cell<gc Vec<string>>
    cells: Cell<gc Vec<gc Cell<i64>>>
}
proc locate(directory: gc Directory, key: string) -> StoragePath<gc Cell<i64>> {
    let names = directory.names.*
    for i in 0..=(names.len() as i64) - 1 {
        if names[i] == key {
            return std::lookup::path(directory).target().field("cells").target().target().element(i)
        }
    }
    return std::lookup::missing<gc Cell<i64>>()
}
proc find(directory: gc Directory, key: string) -> Option<gc Cell<i64>> {
    return std::lookup::mapped(directory, key, locate)
}
proc show(directory: gc Directory, key: string) {
    let entry = find(directory, std::mem::clone(&key))
    if entry.is_none() { std::io::print(key, ": missing"); return }
    std::io::print(key, ": ", entry.unwrap().*.*)
}
let directory = gc Directory {
    names: Cell::new(gc Vec["red"]),
    cells: Cell::new(gc Vec[gc Cell::new(10)]),
}
show(directory, "red")
show(directory, "red")
let cells = directory.cells.*
cells[0].*.* = 20
show(directory, "red")
show(directory, "blue")
show(directory, "blue")
let mut names = std::mem::clone(&directory.names.*.*)
let mut updated = std::mem::clone(&directory.cells.*.*)
updated.push(gc Cell::new(30))
names.push("blue")
directory.cells.* = gc updated
directory.names.* = gc names
show(directory, "blue")
