// Local fixed-size arrays: a literal, element reads, element writes and compound writes.
// Run: cargo run -- run examples/arrays/basic.yas
proc sum_squares(n: i64) -> i64 {
    let mut values = [n, 2, 3]
    values[0] = values[0] * 2
    values[1] += 5
    let mut total = 0
    for i in 0..3 {
        total += values[i] * values[i]
    }
    return total
}

proc smallest(a: i64, b: i64, c: i64) -> i64 {
    let items = [a, b, c]
    let mut best = items[0]
    for i in 1..3 {
        if items[i] < best { best = items[i] }
    }
    return best
}

fn average_of_halves(x: f64, y: f64) -> f64 {
    let mut parts = [x, y]
    parts[0] /= 2.0
    parts[1] /= 2.0
    return parts[0] + parts[1]
}

std::io::print(sum_squares(4))
std::io::print(smallest(9, 3, 7))
std::io::print(average_of_halves(3.0, 5.0))
