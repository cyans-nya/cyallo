// The prelude SDK groups common items by the SDK they come from.
// `use prelude::core::*` brings in Option/Some/None and Result/Ok/Err.
use prelude::core::*

fn first_even(a: i64, b: i64) -> Option<i64> {
    if a % 2 == 0 { return Some(a) }
    if b % 2 == 0 { return Some(b) }
    return None
}
fn halve(n: i64) -> Result<i64, string> {
    if n % 2 != 0 { return Err("odd") }
    return Ok(n / 2)
}

match first_even(3, 8) {
    Some(n) => match halve(n) {
        Ok(half) => std::io::print(half),
        Err(message) => std::io::print(message),
    },
    None => std::io::print("none"),
}
match first_even(3, 5) {
    Some(n) => std::io::print(n),
    None => std::io::print("none"),
}
