// Interactive input and validation. Run: cargo run -- run examples/secret-number.ya
// Try: hello, 2.5, 20, 70, 42. The fixed secret makes the example reproducible.
const secret = 42
let mut guess = 0
let mut answer = ""
std::io::print("Guess a whole number from 1 to 100.")

while guess != secret {
    std::runtime::caie::input(&mut answer)
    let parsed = std::num::parse<i64>(answer)
    if parsed.is_err() {
        std::io::print("Please enter a whole number.")
        continue
    }
    let candidate = parsed.unwrap()
    if candidate < 1 || candidate > 100 {
        std::io::print("Enter a whole number from 1 to 100.")
        continue
    }
    guess = candidate
    if guess < secret {
        std::io::print("Try higher.")
    } else if guess > secret {
        std::io::print("Try lower.")
    } else {
        std::io::print("Correct!")
    }
}
