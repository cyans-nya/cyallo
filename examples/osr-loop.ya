// A long scalar loop for observing promotion within one invocation.
// Run: CYALLO_JIT_START=interpreter cargo run --release -- run examples/osr-loop.ya --engine ng_jit
// Output: 500000500000:1
let mut entries = 0
proc sum_to(limit: i64) -> i64 {
    entries += 1
    let mut total = 0
    for i in 1..=limit { total += i }
    return total
}
std::io::print(sum_to(1000000), ":", entries)
