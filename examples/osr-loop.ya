// A long scalar loop for observing promotion within one invocation.
// Run: cargo run -- run examples/osr-loop.ya --jit-report
let mut entries = 0
proc sum_to(limit: i64) -> i64 {
    entries += 1
    let mut total = 0
    for i = 1 to limit { total += i }
    return total
}
std::io::print(sum_to(1000000), ":", entries)
