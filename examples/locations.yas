// Owned cells, shared GC cells, and retained record fields.
// Run: cargo run -- run examples/locations.yas --gc-stress
record Settings { retries: i64 }
let settings = gc Settings { retries: 2 }
let retries = std::lookup::field(&settings, "retries")
let snapshot = retries.load()
let alias = std::mem::clone(&retries)
alias.store(5)
std::io::print("snapshot: ", snapshot)
std::io::print("field: ", retries.load())

let mut entries = std::collections::Vec[gc Cell::new(gc "first"), gc Cell::new(gc "second")]
let first = entries[0]
entries.push(gc Cell::new(gc "third"))
first.*.* = gc "updated"
std::io::print("first: ", entries[0].*.*.*)
std::io::print("other: ", entries[1].*.*.*)
