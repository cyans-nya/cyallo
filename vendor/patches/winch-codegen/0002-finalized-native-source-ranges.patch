Subject: [PATCH] export finalized native source ranges

Purpose: retain native bytecode origins after assembler label fixups.
Subsystems: standalone AArch64 and x64 native assemblers.
Removal: upstream exports final source ranges for standalone native code.
Base: c307ec81de02852d815e9849f7c89d955c03c30d (50.0.1), after patch 0001.

diff --git a/src/native/aarch64.rs b/src/native/aarch64.rs
index 178730a..f01f396 100644
--- a/src/native/aarch64.rs
+++ b/src/native/aarch64.rs
@@ -62,6 +62,18 @@ impl Assembler {
             .buffer_mut()
             .bind_label(label, &mut Default::default());
     }
+    pub fn start_site(&mut self, site: u32) {
+        self.asm
+            .buffer_mut()
+            .start_srcloc(cranelift_codegen::ir::RelSourceLoc::new(site));
+    }
+    pub fn end_site(&mut self) {
+        self.asm.buffer_mut().end_srcloc();
+    }
+    pub fn finish_image(self) -> Option<(Vec<u8>, Vec<SourceRange>)> {
+        let base = cranelift_codegen::ir::SourceLoc::new(SCALAR_SOURCE_BASE);
+        super::finish_image(self.asm.finalize(Some(base)))
+    }
     pub fn jump(&mut self, label: Label) {
         self.asm.jmp(label);
     }
diff --git a/src/native/mod.rs b/src/native/mod.rs
index d849bb3..2d5661a 100644
--- a/src/native/mod.rs
+++ b/src/native/mod.rs
@@ -3,7 +3,33 @@
     missing_docs,
     reason = "private fork interface documented by the first-party frontend"
 )]
+use cranelift_codegen::MachBufferFinalized;
 pub use cranelift_codegen::MachLabel as Label;
+
+#[derive(Debug, Clone, Copy)]
+pub struct SourceRange {
+    pub site: u32,
+    pub start: u32,
+    pub end: u32,
+}
+
+const SCALAR_SOURCE_BASE: u32 = 0;
+
+fn finish_image(buffer: MachBufferFinalized) -> Option<(Vec<u8>, Vec<SourceRange>)> {
+    if !buffer.relocs().is_empty() {
+        return None;
+    }
+    let ranges = buffer
+        .get_srclocs_sorted()
+        .iter()
+        .map(|range| SourceRange {
+            site: range.loc.as_abs().bits(),
+            start: range.start,
+            end: range.end,
+        })
+        .collect();
+    Some((buffer.data().to_vec(), ranges))
+}
 #[derive(Clone, Copy, Debug)]
 pub enum Condition {
     Eq,
