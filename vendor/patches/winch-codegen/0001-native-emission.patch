+pub mod aarch64;
+#[cfg(feature = "x64")]
+pub mod x64;
+#[cfg(target_arch = "aarch64")]
+pub use aarch64::Assembler;
+#[cfg(target_arch = "x86_64")]
+pub use x64::Assembler;
