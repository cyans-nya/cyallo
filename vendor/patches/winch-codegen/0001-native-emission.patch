+pub enum Condition {
+    Eq,
+    Ne,
+    Lt,
+    Le,
+    Gt,
+    Ge,
+    Lo,
+    Ls,
+    Hi,
+    Hs,
+    Overflow,
+}
+#[derive(Clone, Copy, Debug)]
+pub enum Arithmetic {
+    Add,
+    Sub,
+    Mul,
+    And,
+    Or,
+    Xor,
+}
+#[derive(Clone, Copy, Debug)]
+pub enum FloatArithmetic {
+    Add,
+    Sub,
+    Mul,
+    Div,
+}
